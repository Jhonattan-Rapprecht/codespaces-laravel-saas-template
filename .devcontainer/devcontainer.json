{
  "name": "Laravel SaaS Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  "runServices": [
    "app",
    "mysql",
    "redis",
    "mailpit",
    "phpmyadmin",
    "queue-worker",
    "scheduler",
    "horizon",
    "keycloak",
    "minio",
    "meilisearch",
    "traefik"
  ],

  "postCreateCommand": [
    "cd /workspace && cp -n .env.example .env || true",
    "cd /workspace && composer install",
    "cd /workspace && npm install",
    "cd /workspace && php artisan key:generate",
    "cd /workspace && php artisan migrate --force"
  ],

  "postStartCommand": [
    "cd /workspace && php artisan config:clear",
    "cd /workspace && php artisan route:clear",
    "cd /workspace && php artisan view:clear"
  ],

  "forwardPorts": [
    80,    // Traefik -> app, pma, mailpit, horizon, keycloak, etc
    8082,  // Traefik dashboard
    3306,  // MySQL
    6379,  // Redis
    8025,  // Mailpit UI
    1025,  // Mailpit SMTP
    7700,  // Meilisearch
    9001   // MinIO console (via Traefik or direct)
  ],

  "containerEnv": {
    "APP_ENV": "local",
    "APP_DEBUG": "true",

    "DB_CONNECTION": "mysql",
    "DB_HOST": "mysql",
    "DB_PORT": "3306",
    "DB_DATABASE": "laravel",
    "DB_USERNAME": "laravel",
    "DB_PASSWORD": "laravel",

    "REDIS_HOST": "redis",
    "REDIS_PORT": "6379",

    "MAIL_MAILER": "smtp",
    "MAIL_HOST": "mailpit",
    "MAIL_PORT": "1025",
    "MAIL_ENCRYPTION": "",
    "MAIL_FROM_ADDRESS": "no-reply@local.test",
    "MAIL_FROM_NAME": "Laravel SaaS Dev",

    "FILESYSTEM_DISK": "s3",
    "AWS_ACCESS_KEY_ID": "root",
    "AWS_SECRET_ACCESS_KEY": "rootpassword",
    "AWS_DEFAULT_REGION": "us-east-1",
    "AWS_BUCKET": "local-bucket",
    "AWS_ENDPOINT": "http://minio:9000",

    "SSO_ENABLED": "true",
    "SSO_DRIVER": "oidc",
    "SSO_ISSUER_URL": "http://keycloak:8080/realms/saas",
    "SSO_CLIENT_ID": "laravel-saas",
    "SSO_CLIENT_SECRET": "change-this-in-real-idp",
    "SSO_REDIRECT_URI": "http://app.localhost/auth/callback",
    "SSO_LOGOUT_REDIRECT_URI": "http://app.localhost/",
    "SSO_SCOPES": "openid profile email"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "ms-azuretools.vscode-docker",
        "xdebug.php-debug",
        "onecentlin.laravel-blade",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "mhutchie.git-graph",
        "mehedidracula.php-namespace-resolver"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "php.validate.executablePath": "/usr/local/bin/php",
        "intelephense.environment.phpVersion": "8.4",
        "files.exclude": {
          "**/vendor": true,
          "**/node_modules": true
        }
      }
    }
  }
}
