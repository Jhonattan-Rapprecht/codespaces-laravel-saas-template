{
  "name": "Laravel SaaS Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "runServices": [
    "app",
    "mysql",
    "redis",
    "mailpit",
    "phpmyadmin"
  ],
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "containerEnv": {
    "APP_ENV": "local",
    "APP_DEBUG": "true",
    "XDEBUG_MODE": "debug,develop",
    "XDEBUG_CONFIG": "client_host=localhost client_port=9003"
  },
  "postCreateCommand": "cd /workspace && ([ -f .env ] || cp .env.example .env) && sed -i 's/^DB_CONNECTION=.*/DB_CONNECTION=mysql/;s/^DB_HOST=.*/DB_HOST=mysql/;s/^DB_PORT=.*/DB_PORT=3306/;s/^DB_DATABASE=.*/DB_DATABASE=laravel/;s/^DB_USERNAME=.*/DB_USERNAME=laravel/;s/^DB_PASSWORD=.*/DB_PASSWORD=laravel/;s/^REDIS_HOST=.*/REDIS_HOST=redis/;s/^MAIL_HOST=.*/MAIL_HOST=mailpit/;s/^MAIL_PORT=.*/MAIL_PORT=1025/' .env && composer install && npm install && (grep -q '^APP_KEY=base64' .env || php artisan key:generate) && php artisan migrate --force",
  "postStartCommand": "cd /workspace && php artisan config:clear && php artisan route:clear && php artisan view:clear",
  "forwardPorts": [
    8000,
    5173,
    3306,
    8080,
    8025,
    6379
  ],
  "portsAttributes": {
    "8000": {
      "label": "Laravel",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "phpMyAdmin"
    },
    "8025": {
      "label": "Mailpit"
    },
    "5173": {
      "label": "Vite"
    },
    "3306": {
      "label": "MySQL",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug",
        "onecentlin.laravel-blade",
        "onecentlin.laravel5-snippets",
        "amiralizadeh9480.laravel-extra-intellisense",
        "absszero.vscode-laravel-goto",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "mehedidracula.php-namespace-resolver"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "php.validate.executablePath": "/usr/local/bin/php",
        "intelephense.environment.phpVersion": "8.4",
        "files.exclude": {
          "**/vendor": true,
          "**/node_modules": true
        },
        "search.exclude": {
          "**/vendor": true,
          "**/node_modules": true
        },
        "files.watcherExclude": {
          "**/vendor/**": true,
          "**/node_modules/**": true
        }
      }
    }
  }
}
