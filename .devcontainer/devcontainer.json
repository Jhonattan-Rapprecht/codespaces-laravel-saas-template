{
  "name": "Laravel SaaS Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",


"preCreateCommand": [
  "cd /workspace && [ ! -f .env ] && cp .env.example .env || true",
  "cd /workspace && grep -q 'APP_KEY=' .env || php artisan key:generate"
],

"postCreateCommand": [
  "cd /workspace && composer install",
  "cd /workspace && npm install",
  "cd /workspace && php artisan migrate --force"
],

"postStartCommand": [
  "cd /workspace && php artisan config:clear",
  "cd /workspace && php artisan route:clear",
  "cd /workspace && php artisan view:clear",
  "cd /workspace && php artisan serve --host=0.0.0.0 --port=8000 &"
],


  // Forward important ports
  "forwardPorts": [
    8000, // Laravel
    3306, // MySQL
    6379, // Redis
    8080, // phpMyAdmin
    8025  // Mailpit
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "ms-azuretools.vscode-docker",
        "xdebug.php-debug",
        "onecentlin.laravel-blade"
      ]
    }
  }
}
